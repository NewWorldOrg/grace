{
  "name": "grace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && yarn run prettier:check",
    "prettier": "prettier --write --ignore-path .gitignore './**/*.{js,jsx,ts,tsx,json,css}'",
    "prettier:check": "prettier --check --ignore-path .gitignore './**/*.{js,jsx,ts,tsx,json,css}'",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "codegen": "openapi-typescript libs/api/schema/sophia-swagger.json -o libs/api/generated/sophia.ts --default-non-nullable --properties-required-by-default"
  },
  "dependencies": {
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "openapi-fetch": "^0.17.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/nextjs": "^10.6.3",
    "@storybook/react": "^10.6.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-storybook": "^10.6.3",
    "openapi-typescript": "^7.13.0",
    "storybook": "^10.6.3",
    "typescript": "^5.9.3"
  }
